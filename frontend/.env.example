VITE_APP_TITLE=Cloud Auth Platform
VITE_APP_LOGO_TITLE=Cloud Auth Platform
VITE_APP_ENV=development
VITE_APP_BASE_API=/cloudAuthPlatform/prod-api
# 单体应用填 9215；微服务网关模式填 9212
VITE_APP_PROXY_TARGET=http://127.0.0.1:9215
VITE_APP_CONTEXT_PATH=/cloudAuthPlatform/
VITE_APP_ENCRYPT=true
VITE_APP_RSA_PUBLIC_KEY=replace-with-deployment-public-key
VITE_APP_RSA_PRIVATE_KEY=
VITE_APP_CLIENT_ID=replace-with-client-id
VITE_APP_SSO_PARAM_KEY=replace-with-deployment-key
VITE_APP_WEBSOCKET=false
VITE_APP_SSE=true
