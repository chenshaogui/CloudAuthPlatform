<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.gitee.chenshaogui.cloudauth.system.mapper.SysKeyInfoMapper">
    <resultMap type="io.gitee.chenshaogui.cloudauth.system.domain.vo.SysKeyInfoVo" id="SysKeyInfoResult">
        <id property="id" column="id"/>
    </resultMap>
    <select id="selectJoinVoList" resultMap="SysKeyInfoResult">
        select u.*,d.client_key as clientName
        from sys_key_info u
                 left join sys_client d on u.client_key_id = d.id
            ${ew.getCustomSqlSegment}
    </select>
</mapper>
